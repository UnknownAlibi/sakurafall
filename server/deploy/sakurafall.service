[Unit]
Description=SakuraFall metadata and relay service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sakurafall
Group=sakurafall
EnvironmentFile=/etc/sakurafall/server.env
WorkingDirectory=/opt/sakurafall/server
ExecStart=/usr/local/bin/node src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sakurafall
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=850M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
